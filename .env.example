# Copia questo file in `.env` e compila i valori. Il file `.env` non va mai committato.

# Cartella dei dati (database, backup), fuori dal repo e montata come volume
DATA_DIR=/data

# Porta del server
PORT=3000

# Segreto per le sessioni: genera un valore casuale lungo
SESSION_SECRET=

# Porta sul tuo PC (se la 3100 è occupata, cambiala)
HOST_PORT=3100
